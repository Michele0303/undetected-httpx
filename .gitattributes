# Preserve captured bytes and fixture line endings on every platform.
docs/benchmarks/** -text
docs/demos/** -text
common/httpx/test-data/** -text

# CSV exports and HTTP fixtures use CRLF line endings.
docs/benchmarks/**/*.csv whitespace=cr-at-eol
common/httpx/test-data/** whitespace=cr-at-eol

# Captured terminal output and remote pages retain their own whitespace.
docs/demos/*/capture/*/recorder.txt -whitespace
docs/demos/*/capture/*/responses/** -whitespace
